// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
  previewFeatures = ["nativeTypes"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Test {
  id        Int        @id @default(autoincrement())
  name      String     @db.VarChar(255)
  email     String     @unique @db.VarChar(255)
}

model User {
  id                   Int                @id @default(autoincrement())
  loginName            String             @unique @db.VarChar(30)
  email                String             @unique @db.VarChar(50)
  password             String             @db.VarChar(60)
  avatar               String             @db.VarChar(255) @default("")
  country              String             @db.VarChar(50)
  createdAt            DateTime           @db.Date @default(now())
  username             String             @unique @db.VarChar(30)
  karma                Int                @default(0)
  bio                  String             @db.VarChar(255) @default("")
  birthdate            DateTime           @db.Date
  status               Boolean            @db.Boolean @default(false)
  badges               UserBadge[]
  createdCommunities   Community[]
  communities          CommunityMember[]
  posts                Post[]
  comments             Comment[]
  likes                Like[]
  moderators           Moderator[]
}

enum Rarity {
  Common
  Rare
  Epic
}

model Badge {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(50)
  description String    @db.VarChar(255)
  avatar      String    @db.VarChar(255)
  price       Int
  rarity      Rarity
  users       UserBadge[]
}

model UserBadge {
  userId    Int
  badgeId   Int
  user      User   @relation(fields: [userId], references: [id])
  badge     Badge  @relation(fields: [badgeId], references: [id])
  @@id([userId, badgeId])
}

model Community {
  id              Int               @id @default(autoincrement())
  name            String            @unique @db.VarChar(50)
  description     String            @db.VarChar(255)
  createdAt       DateTime          @db.Date @default(now())
  avatar          String            @db.VarChar(255)
  header          String            @db.VarChar(255)
  ageRestriction  Boolean           @db.Boolean @default(false)
  creatorId       Int
  creator         User              @relation(fields: [creatorId], references: [id])
  moderators      Moderator[]
  members         CommunityMember[]
  tags            CommunityTag[]
  events          Event[]
  posts           Post[]
}

model CommunityMember {
  communityId    Int
  userId         Int
  community      Community   @relation(fields: [communityId], references: [id])
  user           User        @relation(fields: [userId], references: [id])
  @@id([communityId, userId])
}

model Moderator {
  userId         Int
  communityId    Int
  assignedAt     DateTime    @db.Date @default(now())
  assignedBy     String      @db.VarChar(30)
  user           User        @relation(fields: [userId], references: [id])
  community      Community   @relation(fields: [communityId], references: [id])
  events         Event[]
  
  @@id([userId, communityId])
}
model Tag {
  id            Int             @id @default(autoincrement())
  name          String          @unique @db.VarChar(50)
  description   String          @db.VarChar(255)
  group         String?         @db.VarChar(50)
  communities   CommunityTag[]
}

model CommunityTag {
  communityId    Int
  tagId          Int
  community      Community   @relation(fields: [communityId], references: [id])
  tag            Tag         @relation(fields: [tagId], references: [id])
  @@id([communityId, tagId])
}

model Event {
  id                  Int         @id @default(autoincrement())
  title               String      @db.VarChar(50)
  description         String      @db.VarChar(255)
  startsAt            DateTime
  endsAt              DateTime
  address             String      @db.VarChar(255)
  createdAt           DateTime    @db.Date @default(now())
  editStatus          Boolean     @db.Boolean @default(false)
  communityId         Int
  community           Community   @relation(fields: [communityId], references: [id])
  creatorUserId       Int
  creatorCommunityId  Int
  creator             Moderator   @relation(fields: [creatorUserId, creatorCommunityId], references: [userId, communityId])
}

model Post {
  id             Int         @id @default(autoincrement())
  title          String      @db.VarChar(50)
  description    String      @db.VarChar(255)
  createdAt      DateTime    @db.Date @default(now())
  likesCount     Int         @default(0)
  editStatus     Boolean     @db.Boolean @default(false)
  views          Int         @default(0)
  ageRestriction Boolean     @db.Boolean @default(false) 
  communityId    Int
  community      Community   @relation(fields: [communityId], references: [id])
  creatorId      Int
  creator        User        @relation(fields: [creatorId], references: [id])
  comments       Comment[]
  likes          Like[]
  attachment     File?
}

model Comment {
  id             Int         @id @default(autoincrement())
  content        String      @db.VarChar(255)
  createdAt      DateTime    @db.Date @default(now())
  editStatus     Boolean     @db.Boolean @default(false)
  postId         Int
  post           Post        @relation(fields: [postId], references: [id])
  creatorId      Int
  creator        User        @relation(fields: [creatorId], references: [id])
  replies        Reply[]
}

model Reply {
  commentId    Int       @id
  parentId     Int
  parent       Comment   @relation(fields: [parentId], references: [id])
}

model Like {
  id          Int       @id @default(autoincrement())
  likeStatus  Boolean   @db.Boolean @default(false)
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  postId      Int
  post        Post      @relation(fields: [postId], references: [id])
}

model File {
  id        Int       @id @default(autoincrement())
  link      String    @db.VarChar(255)
  content   String    @db.VarChar(255)
  type      String    @db.VarChar(10)
  size      Int
  postId    Int       @unique
  post      Post      @relation(fields: [postId], references: [id])
}

model Administrator {
  id          Int         @id
  assignedAt  DateTime    @db.Date @default(now())
}
